{
  "name": "shaderwave-studio",
  "private": true,
  "version": "0.3.0",
  "description": "Drop an MP3, bind FFT bands to WebGPU shaders, preview visuals, and export MP4 entirely in the browser.",
  "type": "module",
  "scripts": {
    "prepare:pages": "node scripts/prepare-pages.mjs",
    "pages:postbuild": "node scripts/postbuild-pages.mjs",
    "dev": "vite",
    "build": "npm run prepare:pages && tsc -b && vite build && npm run pages:postbuild",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "smoke": "bash scripts/smoke.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pages-preview": "vite preview --host 127.0.0.1 --port 4173",
    "preview": "npm run pages-preview"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query": "^5.100.9",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "comlink": "^4.4.2",
    "fft.js": "^4.0.4",
    "idb": "^8.0.3",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.4",
    "vite-plugin-pwa": "^1.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@webgpu/types": "^0.1.69",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
